# ──────────────────────────────────────
# Telegram Bot
# ──────────────────────────────────────
# Получи у @BotFather командой /newbot
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Telegram ID администраторов через запятую
# Узнай свой ID у @userinfobot
ADMIN_IDS=123456789

# ──────────────────────────────────────
# Stripe (платежи)
# ──────────────────────────────────────
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ──────────────────────────────────────
# eSIM Provider (выбери одного)
# ──────────────────────────────────────
# "mock"    - тестовый режим (без реального API)
# "airalo"  - https://partners.airalo.com
# "esimgo"  - https://www.esim-go.com/api
ESIM_PROVIDER=mock

ESIM_API_KEY=
ESIM_API_URL=

# ──────────────────────────────────────
# Реферальная программа
# ──────────────────────────────────────
REFERRAL_BONUS_EUR=2.0

# ──────────────────────────────────────
# База данных (PostgreSQL)
# ──────────────────────────────────────
POSTGRES_USER=esim_user
POSTGRES_PASSWORD=esim_pass
POSTGRES_DB=esim_db

# Для запуска через docker-compose:
DATABASE_URL=postgresql+asyncpg://esim_user:esim_pass@db:5432/esim_db
