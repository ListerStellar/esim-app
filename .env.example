# ──────────────────────────────────────
# Telegram Bot
# ──────────────────────────────────────
# Получи у @BotFather командой /newbot
BOT_TOKEN=
BOT_USERNAME=
# Telegram ID администраторов через запятую
# Узнай свой ID у @userinfobot
ADMIN_IDS=
# ──────────────────────────────────────
# Stripe (платежи)
# ──────────────────────────────────────
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ──────────────────────────────────────
# Security
# ──────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=15

# ──────────────────────────────────────
# eSIM Provider (выбери одного)
# ──────────────────────────────────────
# "mock"    - тестовый режим (без реального API)
# "airalo"  - https://partners.airalo.com
# "esimgo"  - https://www.esim-go.com/api
ESIM_PROVIDER=mock

ESIM_API_KEY=
ESIM_API_URL=

# ──────────────────────────────────────
# Реферальная программа
# ──────────────────────────────────────
REFERRAL_BONUS_EUR=2.0

# ──────────────────────────────────────
# База данных (PostgreSQL)
# ──────────────────────────────────────
POSTGRES_USER=esim_user
POSTGRES_PASSWORD=esim_pass
POSTGRES_DB=esim_db

# Для запуска через docker-compose:
DATABASE_URL=postgresql+asyncpg://esim_user:esim_pass@db:5432/esim_db

# ──────────────────────────────────────
# Webhooks / Ngrok
# ──────────────────────────────────────
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
WEBHOOK_HOST=
WEBHOOK_PATH=/webhook/bot
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080


VITE_TELEGRAM_BOT_NAME=
# SMTP Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=""
FRONTEND_URL=""

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ESIMACCESS_ACCESS_CODE=
ESIMACCESS_SECRET_KEY=
